  },
  "license": "MIT",
  "engines": {
    "node": ">=24",
    "npm": ">=11.14.0"
  },
  "devDependencies": {
    "@11ty/eleventy-navigation": "^0.3.5",
    "@11ty/eleventy-plugin-rss": "^2.0.2",
    "@11ty/eleventy-plugin-syntaxhighlight": "^5.0.0",
    "@awesome.me/buildawesome": "4.0.0-alpha.10",
    "cross-env": "^7.0.3",
    "luxon": "^3.5.0",
    "markdown-it": "^14.1.0",
    "pagefind": "1.5.2",
    "zod": "^3.23.8",
    "zod-validation-error": "^3.3.1"
  },
